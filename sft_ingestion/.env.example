# .env.example — Gazi SFT Ingestion MVP
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# cp .env.example .env

# PostgreSQL bağlantı dizesi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sft_db

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Parser sürümü (genellikle değiştirilmez)
PARSER_VERSION=1.0
